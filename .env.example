# Copia este archivo como .env y rellena los valores.
# El .env real nunca se sube a git (está en .gitignore).
# Las mismas variables se configuran en el dashboard de Vercel para producción.

# ─── Base de datos (Docker local: pg) ────────────────────────────────────
POSTGRES_USER=autogestion
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=autogestion

APP_PUERTO=3000
DB_PUERTO=5433
DATOS_POSTGRES=./datos/postgres

# Conexión desde la app al Postgres
DATABASE_URL=postgresql://autogestion:cambia_esta_clave@localhost:5433/autogestion

# Conexión directa sin pooler (para `prisma migrate deploy` en producción).
# Si tu proveedor exige pooler, pon aquí la cadena con `?pgbouncer=true&connection_limit=1`.
# DIRECT_URL=

# ─── Acceso a la aplicación ──────────────────────────────────────────────
# Generar con: npm run auth:configurar (interactivo)
AUTH_USUARIO=
AUTH_CLAVE_HASH=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── Cifrado de secretos en reposo ───────────────────────────────────────
# Generar con: npm run cifrado:configurar
# Si se pierde, los secretos guardados son irrecuperables.
# Respáldala aparte (ver documentacion/despliegue.md).
CLAVE_CIFRADO=

# ─── Zona horaria ────────────────────────────────────────────────────────
TZ=America/Bogota

# ─── Google Calendar (HU-10) ─────────────────────────────────────────────
# Obtener en: https://console.cloud.google.com/apis/credentials
# Habilitar: Google Calendar API en la biblioteca de APIs.
# Authorized redirect URI en local: http://localhost:3000/api/calendario/google/callback
# Authorized redirect URI en producción: https://TU-DOMINIO/api/calendario/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendario/google/callback

# ─── Microsoft Calendar (HU-17) ──────────────────────────────────────────
# Obtener en: https://portal.azure.com → Azure Active Directory → App registrations
# Redirect URI en local: http://localhost:3000/api/calendario/microsoft/callback
# Redirect URI en producción: https://TU-DOMINIO/api/calendario/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/calendario/microsoft/callback
