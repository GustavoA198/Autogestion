# Copia este archivo como .env y cambia los valores; el .env real no se sube a git.

# Base de datos usada por Docker Compose (evita símbolos especiales en la contraseña)
POSTGRES_USER=autogestion
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=autogestion

# Puertos publicados solo en localhost
APP_PUERTO=3000
DB_PUERTO=5433

# Carpeta local donde se guardan los datos de PostgreSQL
DATOS_POSTGRES=./datos/postgres

# Conexión desde tu máquina (desarrollo, migraciones y Prisma Studio)
DATABASE_URL=postgresql://autogestion:cambia_esta_clave@localhost:5433/autogestion

# Acceso a la aplicación: no las escribas a mano, las genera `npm run auth:configurar`
AUTH_USUARIO=
AUTH_CLAVE_HASH=
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Clave AES-256 de los secretos (base64, 32 bytes): la genera `npm run cifrado:configurar`. Si se pierde, los secretos son irrecuperables
CLAVE_CIFRADO=
